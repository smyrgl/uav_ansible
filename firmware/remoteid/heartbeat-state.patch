+         */
+        const bool fresh = (last_location_ms != 0 && now_ms - last_location_ms < 5000) &&
+                           (last_system_ms != 0 && now_ms - last_system_ms < 5000);
+        const uint8_t system_status = (parse_fail == nullptr && fresh) ? MAV_STATE_ACTIVE : MAV_STATE_CRITICAL;
         mavlink_msg_heartbeat_send(
             chan,
             MAV_TYPE_ODID,
             MAV_AUTOPILOT_INVALID,
             0,
             0,
-            0);
+            system_status);
 
         // send arming status
         arm_status_send();
