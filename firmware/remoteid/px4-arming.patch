     if (now_ms - last_hb_ms >= 1000) {
         last_hb_ms = now_ms;
+        /*
+          upstream sends system_status 0 (MAV_STATE_UNINIT). PX4 >= 1.15 derives the Remote ID
+          health that COM_ARM_ODID gates on from this field (STANDBY/ACTIVE = healthy), so report
+          our own arming check: ACTIVE while the data we broadcast is complete, fresh and valid,
+          CRITICAL otherwise.
+         */
+        const uint8_t system_status = (parse_fail == nullptr) ? MAV_STATE_ACTIVE : MAV_STATE_CRITICAL;
         mavlink_msg_heartbeat_send(
             chan,
             MAV_TYPE_ODID,
             MAV_AUTOPILOT_INVALID,
             0,
             0,
-            0);
+            system_status);
 
         // send arming status
         arm_status_send();
@@ -184,6 +191,14 @@ void MAVLinkSerial::process_packet(mavlink_status_t &status, mavlink_message_t &
         break;
     }
     case MAVLINK_MSG_ID_OPEN_DRONE_ID_SYSTEM: {
+        if (msg.compid != MAV_COMP_ID_AUTOPILOT1) {
+            /*
+              the operator location we broadcast is the autopilot's take-off location (the Part 89
+              broadcast-module rule). A GCS "always tries to send System" and, without a fix of its
+              own, sends 0/0 every second, which would alternate with the valid location.
+             */
+            break;
+        }
         mavlink_msg_open_drone_id_system_decode(&msg, &system);
         if (g.options & OPTIONS_PRINT_RID_MAVLINK) {
             Serial.printf("MAVLink: got System\n");
@@ -196,6 +211,9 @@ void MAVLinkSerial::process_packet(mavlink_status_t &status, mavlink_message_t &
         break;
     }
     case MAVLINK_MSG_ID_OPEN_DRONE_ID_SYSTEM_UPDATE: {
+        if (msg.compid != MAV_COMP_ID_AUTOPILOT1) {
+            break;      // see OPEN_DRONE_ID_SYSTEM
+        }
         if (g.options & OPTIONS_PRINT_RID_MAVLINK) {
             Serial.printf("MAVLink: got System update\n");
         }
