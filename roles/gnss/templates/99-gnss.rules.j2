# Managed by uav_ansible — stable symlink for the GNSS receiver.
# One rule per entry in gnss_udev_receivers (group_vars/all.yml): the USB vendor
# and the CDC interface that carries the data stream.
{% for r in gnss_udev_receivers %}
# {{ r.name }}
SUBSYSTEM=="tty", ATTRS{idVendor}=="{{ r.vendor }}", ENV{ID_USB_INTERFACE_NUM}=="{{ r.interface }}", SYMLINK+="{{ gnss_udev_symlink }}", MODE="0660", GROUP="dialout"
{% endfor %}
