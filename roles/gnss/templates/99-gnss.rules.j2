# Managed by uav_ansible — stable symlink for the GNSS receiver.
# Set gnss_udev_idvendor from `lsusb` (the receiver's 4-hex VID), then re-run.
{% if gnss_udev_idvendor %}
SUBSYSTEM=="tty", ATTRS{idVendor}=="{{ gnss_udev_idvendor }}", SYMLINK+="{{ gnss_udev_symlink }}", MODE="0660", GROUP="dialout"
{% else %}
# (gnss_udev_idvendor not set yet — fill it in, then re-run the gnss role.)
{% endif %}
