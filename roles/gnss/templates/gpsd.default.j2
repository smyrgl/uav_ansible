# Managed by uav_ansible.
# gpsd reads the broker for time and never writes. It takes the GNSS stream
# (NMEA, UBX or SBF, auto-detected) from the broker's port and exports SHM(0)
# for chrony. RTCM is written to the same broker port by drone-link-connect,
# enrolled at runtime from the station's Connectors page (README, "RTK
# corrections"). gpsd carries no ntrip:// device: one RTCM writer, not two.
START_DAEMON="true"
USBAUTO="false"
DEVICES="tcp://127.0.0.1:{{ gnss_broker_port }}"
# -n: poll continuously so SHM is exported without a connected client.
GPSD_OPTIONS="-n"
