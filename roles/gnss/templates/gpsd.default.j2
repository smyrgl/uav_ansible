# Managed by uav_ansible.
# gpsd reads the GNSS stream from the broker's read-broadcast port (NMEA or SBF,
# auto-detected) and exports SHM(0) for chrony. RTCM/NTRIP is handled separately
# (an NTRIP client writes to the broker's write port), so gpsd is read-only here.
START_DAEMON="true"
USBAUTO="false"
DEVICES="tcp://127.0.0.1:{{ gnss_broker_read_port }}"
# -n: poll continuously so SHM is exported without a connected client.
GPSD_OPTIONS="-n"
