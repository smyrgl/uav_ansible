[Unit]
Description=uav_ansible GNSS serial broker (single-port tee + RTCM inject)
After=network.target

[Service]
Type=simple
Environment=SERIAL_DEV={{ gnss_serial }}
Environment=SERIAL_BAUD={{ gnss_baud }}
Environment=PORT={{ gnss_broker_port }}
ExecStart=/usr/bin/python3 /usr/local/bin/uav-gnss-broker.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
