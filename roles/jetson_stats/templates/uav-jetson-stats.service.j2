[Unit]
Description=UAV Jetson platform stats (jtop) -> ROS 2 /diagnostics
After=network-online.target jtop.service
Wants=network-online.target jtop.service
PartOf=uav-ros.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ jetson_stats_user }}
Group={{ jetson_stats_user }}
EnvironmentFile={{ jetson_stats_environment_file }}
Environment=ROS_LOG_DIR=/var/log/uav-ros
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_distro }}/setup.bash && source {{ jetson_stats_workspace }}/install/local_setup.bash && exec {{ jetson_stats_venv }}/bin/python {{ jetson_stats_workspace }}/install/lib/isaac_ros_jetson_stats/jtop --ros-args -p interval:={{ jetson_stats_interval_sec | float }}'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
StateDirectory=uav-ros
LogsDirectory=uav-ros
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
