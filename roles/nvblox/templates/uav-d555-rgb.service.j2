[Unit]
Description=D555 native yuv422_yuy2 -> rectified rgb8 + zero-distortion CameraInfo (nvblox colour input)
After=network-online.target uav-d555-frames.service
Wants=network-online.target uav-d555-frames.service
PartOf=uav-ros.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ nvblox_service_user }}
Group={{ nvblox_service_user }}
EnvironmentFile={{ nvblox_environment_file }}
Environment=ROS_LOG_DIR=/var/log/uav-ros
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_distro }}/setup.bash; exec /usr/bin/python3 /usr/local/lib/uav/d555_rgb_adapter.py --serial {{ nvblox_d555_serial }} --image-topic {{ nvblox_color_source_topic }} --camera-info-topic {{ nvblox_color_camera_info_source_topic }} --output-namespace {{ nvblox_color_rect_namespace }} --max-rate {{ nvblox_color_max_rate_hz }}'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
StateDirectory=uav-ros
LogsDirectory=uav-ros
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
