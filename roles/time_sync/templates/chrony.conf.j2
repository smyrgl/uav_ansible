# Managed by uav_ansible.
# Coarse time-of-day from the receiver: SBF ReceiverTime, sent by uav-gnss-time
# (gnss role) once a second while the receiver clock is synchronised. It says
# which second it is; the PPS below says where each second begins.
#   offset    samples are stamped on arrival, so they trail true time by the SBF
#             output latency; this adds it back (gnss_time_offset).
#   precision arrival jitter is milliseconds (not NMEA's 100s of ms), and the
#             PPS lock needs |GPS - PPS| plus both dispersions under 0.2 s.
#   delay     keeps it a last resort next to PPS and even the network pool.
# Selectable, not noselect: in the field there is no network, and without PPS
# (a broken wire) this is the only source that takes the clock out of 1970.
refclock SOCK {{ gnss_time_sock }} refid GPS precision 1e-2 offset {{ gnss_time_offset }} delay 0.2

# Precise edge from the GPIO 1PPS ({{ pps_device }}), labelled by the GPS source.
# The refclock line is written at each start by uav-chrony-pps (ExecStartPre)
# only if the device exists: chronyd treats a missing refclock device as fatal.
include /run/chrony/uav-pps.conf

# A network pool beside the receiver. This board has no battery RTC and boots at
# January 1st; a companion that learns the time only from its own receiver cannot
# verify a certificate (the drone-link QUIC handshake) until it has a fix, and on
# a bench that can be never. maxsources 2 keeps the pool a minority next to GPS/PPS.
pool ntp.ubuntu.com iburst maxsources 2

# Step the clock if off by > 1s on the first 3 updates (boot convergence).
makestep 1.0 3
rtcsync

# Serve NTP to LAN clients that can't do PTP (fallback/general timekeeping).
{% for subnet in chrony_serve_subnets %}
allow {{ subnet }}
{% endfor %}
# Remain a usable server even before GNSS lock (holdover).
local stratum 10

# Leap seconds from tzdata, as Ubuntu's stock config has it: the SBF time feed
# sends no leap-second warning.
leapsectz right/UTC

driftfile /var/lib/chrony/chrony.drift
logdir /var/log/chrony
log measurements statistics tracking
