[Unit]
Description=UAV PX4 bridge: uORB (/fmu/out) -> ROS-native ENU/FLU topics
After=network-online.target uav-xrce-agent.service
Wants=network-online.target
PartOf=uav-ros.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ px4_bridge_user }}
Group={{ px4_bridge_user }}
EnvironmentFile={{ px4_bridge_environment_file }}
Environment=ROS_LOG_DIR=/var/log/uav-ros
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_distro }}/setup.bash && source {{ px4_bridge_workspace }}/install/local_setup.bash && source {{ px4_bridge_px4_msgs_workspace }}/install/local_setup.bash && exec {{ px4_bridge_workspace }}/install/lib/uav_px4_bridge/px4_bridge --ros-args --params-file {{ px4_bridge_config }}'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
StateDirectory=uav-ros
LogsDirectory=uav-ros
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
