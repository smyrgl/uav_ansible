/dts-v1/;
/plugin/;

/* pps-gpio overlay — Mosaic 1PPS on header pin {{ dt_pps_gpio_header_pin }} -> /dev/pps0
 * TODO: replace <&gpio PIN GPIO_ACTIVE_HIGH> with the resolved Tegra GPIO for
 *       this header pin, and confirm the gpio controller phandle/label.
 */
/ {
    fragment@0 {
        target-path = "/";
        __overlay__ {
            pps {
                compatible = "pps-gpio";
                /* gpios = <&TODO_gpio_controller TODO_pin_offset 0>; */
                assert-rising-edge;
                status = "okay";
            };
        };
    };
};
