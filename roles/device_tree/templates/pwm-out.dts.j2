/dts-v1/;
/plugin/;

/* PWM output — drives the RP2040 (neopixels)
 * Resolved from NVIDIA Orin NX/Nano Pinmux Template v1.2:
 *   SODIMM signal GPIO12 (pin 218) -> SOC ball GP88_PWM1 -> GPIO3_PN.01 ({{ dt_pwm_dt_pin_name }})
 *   SFIO0 = GP_PWM1  (devkit usage: "Baseboard 40 Pin Header PWM")
 *
 * Node labels CONFIRMED on-device (JetPack 7.2 __symbols__):
 *   &{{ dt_pwm_controller_label }}   = /bus@0/pwm@3280000     (GP_PWM1)
 *   &pinmux = /bus@0/pinmux@2430000
 * Remaining: the exact nvidia,function string + Tegra pinmux state wiring. On
 * Tegra the pinmux is normally set by MB1, so the supported way to enable a
 * 40-pin PWM is jetson-io — generate it there for this pin and reconcile the
 * fragment@0 (pinmux) block below against jetson-io's output before trusting it.
 */
/ {
    overlay-name = "uav-pwm-out";

    /* 1) Mux {{ dt_pwm_dt_pin_name }} to its PWM function. */
    fragment@0 {
        target = <&pinmux>;           /* confirmed: /bus@0/pinmux@2430000 */
        __overlay__ {
            {{ dt_pwm_dt_pin_name }}_pwm {
                nvidia,pins = "{{ dt_pwm_dt_pin_name }}";
                nvidia,function = "{{ dt_pwm_function }}";
                nvidia,tristate = <0x0>;
                nvidia,enable-input = <0x0>;
            };
        };
    };

    /* 2) Enable the PWM controller -> exposes /sys/class/pwm/pwmchipN. */
    fragment@1 {
        target = <&{{ dt_pwm_controller_label }}>;
        __overlay__ {
            status = "okay";
        };
    };
};
