[Unit]
Description=UAV robot_localization EKF, odom layer (continuous sources; odom -> base_link)
After=network-online.target uav-px4-bridge.service
Wants=network-online.target
PartOf=uav-ros.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ localization_user }}
Group={{ localization_user }}
EnvironmentFile={{ localization_environment_file }}
Environment=ROS_LOG_DIR=/var/log/uav-ros
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_distro }}/setup.bash && exec ros2 run robot_localization ekf_node --ros-args -r __node:=ekf_odom --params-file {{ localization_ekf_odom_config }} -r odometry/filtered:=/odometry/filtered/odom'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
StateDirectory=uav-ros
LogsDirectory=uav-ros
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
