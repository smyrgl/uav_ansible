# Managed by uav_ansible — do not edit by hand.
# Uplink: USB Wi-Fi dongle (wifi_interface) — the Jetson's default route / internet egress.
# Its own file so it can be applied, and proven, BEFORE the LAN cutover (see
# roles/networking/tasks/main.yml).
network:
  version: 2
  renderer: {{ netplan_renderer }}
  wifis:
    {{ wifi_interface }}:
      dhcp4: true
      # Below the GCS tunnel's default route: the bench prefers wifi when both are up.
      dhcp4-overrides:
        route-metric: {{ wifi_route_metric | default(50) }}
      access-points:
        "{{ wifi_ssid }}":
          password: "{{ wifi_password }}"
