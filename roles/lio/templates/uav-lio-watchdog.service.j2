[Unit]
Description=FAST-LIO watchdog (log + odometry -> /lio/health for the map and the E1R registration)
After=network-online.target uav-lio.service
Wants=network-online.target
PartOf=uav-ros.target
StartLimitIntervalSec=0

[Service]
Environment=UAV_EVENTS_EXECUTOR={{ '1' if (ros_events_executor | default(false) | bool) else '0' }}
Type=simple
User={{ lio_service_user }}
Group={{ lio_service_user }}
# FAST-LIO's log is in the system journal.
SupplementaryGroups=systemd-journal
EnvironmentFile={{ lio_environment_file }}
Environment=ROS_LOG_DIR=/var/log/uav-ros
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_distro }}/setup.bash; exec /usr/bin/python3 /usr/local/lib/uav/lio_watchdog.py --unit uav-lio.service --sustain {{ lio_watchdog_sustain_s }} --max-speed {{ lio_max_speed_mps }}'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=10
StateDirectory=uav-ros
LogsDirectory=uav-ros
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
