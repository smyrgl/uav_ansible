[Unit]
Description=E1R registered with FAST-LIO poses ({{ lio_e1r_topic }} -> {{ lio_e1r_registered_topic }}, lio/e1r diagnostic)
After=network-online.target uav-lio.service
Wants=network-online.target
PartOf=uav-ros.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ lio_service_user }}
Group={{ lio_service_user }}
EnvironmentFile={{ lio_environment_file }}
Environment=ROS_LOG_DIR=/var/log/uav-ros
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_distro }}/setup.bash; exec /usr/bin/python3 /usr/local/lib/uav/lio_register.py --name e1r --input-topic {{ lio_e1r_topic }} --time-field {{ lio_e1r_time_field }} --output-topic {{ lio_e1r_registered_topic }} --imu-lever-arm {{ lio_imu_lever_arm | join(" ") }} --min-range {{ lio_e1r_min_range_m }} --max-range {{ lio_e1r_max_range_m }} --max-pose-gap {{ lio_e1r_max_pose_gap_s }} --max-wait {{ lio_e1r_max_wait_s }}'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
StateDirectory=uav-ros
LogsDirectory=uav-ros
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
