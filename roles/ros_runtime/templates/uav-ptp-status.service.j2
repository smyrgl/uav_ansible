[Unit]
Description=Read-only PTP to UTC mapping verification
After=uav-ptp4l.service uav-phc2sys.service
Wants=uav-ptp4l.service uav-phc2sys.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/uav/ptp_status.py --interface {{ ptp_grandmaster_interface }} --domain {{ ptp_domain }}
Restart=on-failure
RestartSec=2
RuntimeDirectory=uav/time
RuntimeDirectoryMode=0755
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=char-ptp r
UMask=0022

[Install]
WantedBy=multi-user.target
