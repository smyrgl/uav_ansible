#!/bin/bash
# Managed by uav_ansible (replay). Replay and score every signed-off bag in the
# flights dataset that has no replay yet (one at a time; a run marks the bag
# with .replayed so a failed score is not retried forever: delete the stamp to
# retry).
set -eo pipefail
FLIGHTS={{ replay_flights_dir }}
for dir in "$FLIGHTS"/flight_*/; do
  dir="${dir%/}"; name=$(basename "$dir")
  case "$name" in *_replay_*) continue ;; esac
  [ -f "$dir/flight.json" ] && grep -q '"signoff"' "$dir/flight.json" || continue
  [ -f "$dir/.pushed" ] || continue      # the offload writes this after the bag's data has landed
  [ -f "$dir/.replayed" ] && continue
  # Stage 1 truth first: it needs only the bag, so a failed replay never hides it.
  if {{ replay_venv }}/bin/python /usr/local/lib/uav/estimator_truth.py "$dir" --out "$dir/truth.json" > "$dir.truth.log" 2>&1; then
    echo "$(date -u +%FT%TZ) $name: $(grep -E '^TRUTH ' "$dir.truth.log" | tail -1)"
  else
    echo "$(date -u +%FT%TZ) $name: truth exited $? ($(grep -E '^TRUTH ' "$dir.truth.log" | tail -1))"
  fi
  echo "$(date -u +%FT%TZ) replaying $name"
  if /usr/local/bin/uav-replay "$dir" --out "${dir}_replay_$(date -u +%Y%m%dT%H%M%SZ)" > "$dir.replay.log" 2>&1; then
    echo "$(date -u +%FT%TZ) $name: $(grep -E '^REPLAY ' "$dir.replay.log" | tail -1)"
  else
    echo "$(date -u +%FT%TZ) $name: replay exited $? ($(grep -E '^REPLAY ' "$dir.replay.log" | tail -1))"
  fi
  date -u +%FT%TZ > "$dir/.replayed"
done
