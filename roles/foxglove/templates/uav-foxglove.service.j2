[Unit]
Description=UAV Foxglove ROS 2 visualization bridge
After=network-online.target uav-description.service uav-d555-frames.service
Wants=network-online.target uav-d555-frames.service
PartOf=uav-ros.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ uav_ros_user }}
Group={{ uav_ros_user }}
EnvironmentFile={{ uav_ros_environment_file }}
Environment=ROS_LOG_DIR=/var/log/uav-ros
ExecStart=/usr/local/libexec/uav-foxglove
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
StateDirectory=uav-ros
LogsDirectory=uav-ros
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
