[Unit]
Description=UAV D555 depth relay for dashboards ({{ foxglove_depth_throttle_hz }} Hz, topic_tools throttle)
After=network-online.target
Wants=network-online.target
PartOf=uav-ros.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ uav_ros_user }}
Group={{ uav_ros_user }}
EnvironmentFile={{ uav_ros_environment_file }}
Environment=ROS_LOG_DIR=/var/log/uav-ros
# The D555 unicasts a full copy of the raw depth stream to every subscriber
# (~217 Mbit/s at 896x504@30). This relay is that one subscriber on the LAN and
# republishes at a dashboard rate; Foxglove subscribes to the relay instead.
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_distro }}/setup.bash; exec ros2 run topic_tools throttle messages {{ foxglove_depth_source_topic }} {{ foxglove_depth_throttle_hz }} {{ foxglove_depth_throttled_topic }} --ros-args -r __node:=d555_depth_throttle'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
StateDirectory=uav-ros
LogsDirectory=uav-ros
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
