# One Livox point (Livox's livox_ros_driver2 layout).
uint32 offset_time      # ns after the message's timebase
float32 x               # m
float32 y               # m
float32 z               # m
uint8 reflectivity      # 0-255
uint8 tag               # Livox tag (return and confidence bits)
uint8 line              # laser line
