<?xml version="1.0"?>
<package format="3">
  <name>uav_flight_recorder</name><version>0.1.0</version>
  <description>Records a rosbag2 (mcap) of every flight: starts on arming, keeps rolling through disarm, stops once the vehicle is safed.</description>
  <maintainer email="john@localhost">John</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_msgs</exec_depend><exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>ros2bag</exec_depend><exec_depend>rosbag2_storage_mcap</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
