---
# Copy to group_vars/vault.yml, fill in, then:  ansible-vault encrypt group_vars/vault.yml
# vault.yml is git-ignored. Run the playbook with --ask-vault-pass.
# (RTK corrections are not a secret here: drone-link is enrolled from the
#  station after the converge — see README, "RTK corrections".)
# --- Wi-Fi uplink ---
vault_wifi_ssid: "your-wifi-ssid"
vault_wifi_password: "your-wifi-password"
