# Secrets — never commit decrypted vault
group_vars/vault.yml

# Ansible runtime
*.retry
.galaxy/
fact_cache/

# Python
__pycache__/
*.pyc

# Editor
.vscode/
*.swp

# macOS
.DS_Store

# Claude Code local settings (machine-local; not for publishing)
.claude/settings.local.json

# Logs / local scratch
*.log

# Blender auto-backups and dated manual backups of the airframe model
*.blend1
x950_description/*_backup_*.blend

# pytest
.pytest_cache/

# Bag offload: the aircraft's public key fetched for the replay host
.offload-keys/

# Mission plans and their item tables carry launch coordinates: never in a public repo
docs/flight-cards/*.plan
docs/flight-cards/*.items.md
firmware/*/build/
